PORT=3000

# AI ENGINE (legacy PR flow only; not used by incident coordination)
GEMINI_API_KEY=

# SLACK
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_STATE_SECRET=
SLACK_BOT_TOKEN=
# App-level token (xapp-...) for Socket Mode. Requires the `connections:write`
# scope on your Slack app. When set, events arrive over WebSocket; otherwise
# the HTTP Events API receiver is used.
SLACK_APP_TOKEN=
BOT_USER_ID=

# GITHUB (legacy PR flow only; optional — server boots without it)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=

# MONGODB
MONGODB_URI=
MONGODB_USER=
MONGODB_PASSWORD=

# TOKEN ENCRYPTION (required in production for Slack bot-token encryption at rest)
TOKEN_ENCRYPTION_KEY=

# OBSERVABILITY (generic OpenTelemetry; no vendor endpoint by default)
OTEL_TRACES_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_NODE_RESOURCE_DETECTORS=env,host,os
OTEL_SERVICE_NAME=runbookai-backend
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0
OTEL_EXPORTER_OTLP_HEADERS=
